PORT=5001
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dawaya

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Email (Nodemailer — use Gmail or any SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="DAWAYA Pharmacy <no-reply@dawaya.com>"

# Twilio SMS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# OTP
OTP_EXPIRES_MINUTES=10

# Frontend URL (for reset password link)
FRONTEND_URL=http://localhost:3000

# ── Google OAuth ──────────────────────────────────────────────
# Web client ID — must match Flutter `GoogleAuthConfig.webClientId`
# Get from: https://console.cloud.google.com → Credentials → Web application
GOOGLE_CLIENT_ID=462093455929-tmmk7lu77q1qqvldjmnj3h30mthg6jbh.apps.googleusercontent.com
# Not used by POST /api/auth/google (ID token verify only)
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Firebase Cloud Messaging (push notifications) ─────────────
# Path to Firebase service account JSON (Project Settings → Service accounts → Generate key)
# Leave unset to keep in-app notifications only (no push).
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# News (https://newsapi.org) — server-side only, never put it in the app
NEWS_API_KEY=your_newsapi_key

# Browser origins allowed by CORS (comma-separated). Leave empty in development.
CORS_ORIGINS=
