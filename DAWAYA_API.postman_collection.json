        { "name": "Add to Wishlist", "request": { "method": "POST", "url": "{{baseUrl}}/wishlist/MEDICINE_ID", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "Remove from Wishlist", "request": { "method": "DELETE", "url": "{{baseUrl}}/wishlist/MEDICINE_ID", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "Move to Cart", "request": { "method": "POST", "url": "{{baseUrl}}/wishlist/MEDICINE_ID/move-to-cart", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "Clear Wishlist", "request": { "method": "DELETE", "url": "{{baseUrl}}/wishlist", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } }
      ]
    },
    {
      "name": "⭐ Reviews",
      "item": [
        { "name": "Get Medicine Reviews", "request": { "method": "GET", "url": "{{baseUrl}}/reviews/MEDICINE_ID" } },
        {
          "name": "Create Review",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/reviews/MEDICINE_ID",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"rating\": 5,\n  \"title\": \"Great medicine!\",\n  \"comment\": \"Very effective, fast relief.\"\n}" }
          }
        },
        { "name": "Get My Reviews", "request": { "method": "GET", "url": "{{baseUrl}}/reviews/my", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
