          "request": {
            "method": "POST", "url": "{{baseUrl}}/prescriptions",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": { "mode": "formdata", "formdata": [{ "key": "prescription", "type": "file", "src": "" }, { "key": "ocrText", "value": "Panadol\nAmoxil 500mg" }, { "key": "doctorName", "value": "Dr. Smith" }] }
          }
        },
        { "name": "Get My Prescriptions", "request": { "method": "GET", "url": "{{baseUrl}}/prescriptions", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
